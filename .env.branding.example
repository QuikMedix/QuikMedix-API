# Merge into your deployment environment; keep existing configured credentials.
APP_NAME=QuikMedix
APP_URL=https://app.quikmedix.com
CHATIFY_NAME=QuikMedix
MAIL_FROM_NAME=QuikMedix
MAIL_FROM_ADDRESS=

QUIKMEDIX_LEGAL_NAME=QuikMedix
QUIKMEDIX_SUPPORT_EMAIL=info@quikmedix.com
QUIKMEDIX_SUPPORT_PHONE="(929) 969-8910"
QUIKMEDIX_BILLING_EMAIL=info@quikmedix.com
QUIKMEDIX_BUSINESS_ADDRESS="1833 W 12th Street, Brooklyn, NY 11223"
QUIKMEDIX_INVOICE_SIGNATORY=
# Relative path beneath public/; use an authorized signature only.
QUIKMEDIX_INVOICE_SIGNATURE=
QUIKMEDIX_TELEGRAM_AUTH_URL=
QUIKMEDIX_DOWNLOAD_URL=
# Reserved, non-deliverable namespace for phone-only accounts, not support email.
QUIKMEDIX_ACCOUNT_EMAIL_DOMAIN=accounts.quikmedix.invalid

# Original form artwork, relative to public/. Missing forms cannot be printed.
QUIKMEDIX_AUTHORIZATION_FORM=
QUIKMEDIX_AUTHORIZATION_INSTRUCTIONS=
QUIKMEDIX_PARTNER_FORM_HEADER=
QUIKMEDIX_PARTNER_FORM_FOOTER=

# Configure QuikMedix-owned service accounts where these features are used.
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
TWILIO_CHAT_SERVICE_SID=
TWILIO_NOTIFY_CLIENT_SERVICE_SID=
TWILIO_NOTIFY_CLIENT_IOS_SERVICE_SID=
TWILIO_NOTIFY_DRIVER_IOS_SERVICE_SID=
TWILIO_NOTIFY_DRIVER_SERVICE_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
GOOGLE_MAPS_API_KEY=
PUSHER_BEAMS_INSTANCE_ID=
PUSHER_BEAMS_SECRET_KEY=
FCM_SERVER_KEY=
FCM_NOTIFICATION_ICON=quikmedix_notification
TELEGRAM_BOT_TOKEN=
TIDIO_WIDGET_KEY=
# Frontend chat token, compiled into the JS bundle when this service is used.
MIX_LARASOCKET_TOKEN=
